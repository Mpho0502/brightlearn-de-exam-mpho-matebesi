          SQLTask:Connection="{32079122-8877-4C11-9042-B0ED79C6509A}"
          SQLTask:SqlStatementSource="--Create a table with proper DATE data types set to NOT NULL&#xA;IF OBJECT_ID('[dwh_bright_mart_sales].[dbo].[dwh_dim_payment]', 'U') IS NULL&#xA;    CREATE TABLE [dwh_bright_mart_sales].[dbo].[dwh_dim_payment](&#xA;        [PaymentID]      INT IDENTITY(1, 1) PRIMARY KEY,&#xA;        [payment_method] VARCHAR(50) NOT NULL, &#xA;        [load_date]      DATETIME DEFAULT GETDATE()&#xA; );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
