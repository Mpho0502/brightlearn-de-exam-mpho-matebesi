    <DTS:Executable
      DTS:refId="Package\load_clean_dim_payment"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="load_clean_dim_payment"
      DTS:DTSID="{f14888a0-d816-4c47-aa00-1ff3ca9ef5e8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load_clean_dim_payment"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1A5251C7-D9D3-4D89-968D-6EB2AF2109D3}"
          SQLTask:SqlStatementSource="-- Insert distinct values using WHERE NOT EXISTS and handling NULLs&#xA;INSERT INTO [stg_bright_mart_sales].[dbo].[clean_dim_payment] ( &#xA;        [payment_method] &#xA;) &#xA;SELECT DISTINCT &#xA;    -- If the payment method is missing or NULL, fallback to an 'Unknown' placeholder&#xA;    COALESCE([payment_method], 'Unknown') AS [payment_method] &#xA;FROM [stg_bright_mart_sales].[dbo].[bright_mart_raw_data] AS srd&#xA;WHERE  [payment_method] IS NOT NULL&#xA;  AND NOT EXISTS (&#xA;      SELECT 1 &#xA;      FROM [stg_bright_mart_sales].[dbo].[clean_dim_payment] AS cdp&#xA;      WHERE cdp.[payment_method] = COALESCE(srd.[payment_method], 'Unknown')&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\load_data_stg_payment"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="load_data_stg_payment"
      DTS:DTSID="{4b6c5ed1-ce34-462f-a2d0-c30bd6e8ac51}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load_data_stg_payment"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1A5251C7-D9D3-4D89-968D-6EB2AF2109D3}"
          SQLTask:SqlStatementSource="-- Insert distinct values into the table from raw data only if they do not already exist&#xA;INSERT INTO [stg_bright_mart_sales].[dbo].[dim_payment] (&#xA;        [payment_method]&#xA;)&#xA;SELECT DISTINCT&#xA;        raw.[payment_method]&#xA;FROM [stg_bright_mart_sales].[dbo].[bright_mart_raw_data] raw&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 &#xA;    FROM [stg_bright_mart_sales].[dbo].[dim_payment] dim&#xA;    WHERE ISNULL(dim.[payment_method], '') = ISNULL(raw.[payment_method], '')&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\load_dwh_dim_payment"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
