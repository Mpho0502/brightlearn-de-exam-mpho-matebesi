    <DTS:Executable
      DTS:refId="Package\load_clean_dim_date"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="load_clean_dim_store"
      DTS:DTSID="{78eebc68-920c-4dbf-9184-2b75dd88c54b}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load_clean_dim_date"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1A5251C7-D9D3-4D89-968D-6EB2AF2109D3}"
          SQLTask:SqlStatementSource="-- Insert rows using WHERE NOT EXISTS to prevent duplicates across multiple execution runs&#xA;INSERT INTO [stg_bright_mart_sales].[dbo].[clean_dim_date] ( &#xA;        [transaction_date], &#xA;        [customer_since] &#xA;) &#xA;SELECT DISTINCT &#xA;    -- If conversion fails or raw data is NULL, fallback to a default '1900-01-01' date &#xA;    COALESCE(TRY_CONVERT(DATE, [transaction_date]), '1900-01-01') AS [transaction_date], &#xA;    COALESCE(TRY_CONVERT(DATE, [customer_since]), '1900-01-01') AS [customer_since] &#xA;FROM [stg_bright_mart_sales].[dbo].[bright_mart_raw_data] AS srd&#xA;WHERE ([transaction_date] IS NOT NULL OR &#xA;       [customer_since] IS NOT NULL)&#xA;  AND NOT EXISTS (&#xA;      SELECT 1 &#xA;      FROM [stg_bright_mart_sales].[dbo].[clean_dim_date] AS cdd&#xA;      WHERE cdd.[transaction_date] = COALESCE(TRY_CONVERT(DATE, srd.[transaction_date]), '1900-01-01')&#xA;        AND cdd.[customer_since]   = COALESCE(TRY_CONVERT(DATE, srd.[customer_since]), '1900-01-01')&#xA;  );&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\load_data_stg_date"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="load_data_stg_date"
      DTS:DTSID="{53d907e9-2ef4-4ce6-95a0-2e34827f042e}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load_data_stg_date"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1A5251C7-D9D3-4D89-968D-6EB2AF2109D3}"
          SQLTask:SqlStatementSource="-- Insert distinct values into the table from raw data only if they do not already exist&#xA;INSERT INTO [stg_bright_mart_sales].[dbo].[dim_date] (&#xA;        [transaction_date],&#xA;        [customer_since]&#xA;)&#xA;SELECT DISTINCT&#xA;        raw.[transaction_date],&#xA;        raw.[customer_since]&#xA;FROM [stg_bright_mart_sales].[dbo].[bright_mart_raw_data] raw&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 &#xA;    FROM [stg_bright_mart_sales].[dbo].[dim_date] dim&#xA;    WHERE ISNULL(dim.[transaction_date], '') = ISNULL(raw.[transaction_date], '')&#xA;      AND ISNULL(dim.[customer_since], '')   = ISNULL(raw.[customer_since], '')&#xA;);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\load_dwh_dim_date"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="load_dwh_dim_date"
      DTS:DTSID="{44967787-d48c-4ffb-b729-5a45d5ba9f62}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load_dwh_dim_date"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{32079122-8877-4C11-9042-B0ED79C6509A}"
          SQLTask:SqlStatementSource="INSERT INTO [dwh_bright_mart_sales].[dbo].[dwh_dim_date] (&#xA;        [transaction_date],&#xA;        [customer_since]&#xA;)&#xA;SELECT DISTINCT&#xA;        cln.[transaction_date],&#xA;        cln.[customer_since]&#xA;FROM [stg_bright_mart_sales].[dbo].[clean_dim_date] cln&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 &#xA;    FROM [dwh_bright_mart_sales].[dbo].[dwh_dim_date] dim&#xA;    WHERE ISNULL(dim.[transaction_date], '') = ISNULL(cln.[transaction_date], '')&#xA;      AND ISNULL(dim.[customer_since], '')   = ISNULL(cln.[customer_since], '')&#xA;);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
