      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{32079122-8877-4C11-9042-B0ED79C6509A}"
          SQLTask:SqlStatementSource="-- Create a table with proper DATE data types &#xA;IF OBJECT_ID('[dwh_bright_mart_sales].[dbo].[dwh_dim_date]', 'U') IS NULL&#xA;    CREATE TABLE [dwh_bright_mart_sales].[dbo].[dwh_dim_date](&#xA;        [DateID] INT IDENTITY(1, 1) PRIMARY KEY,&#xA;        [transaction_date] DATE NOT NULL,      &#xA;        [customer_since] DATE NOT NULL,       &#xA;        [load_date] DATETIME DEFAULT GETDATE()&#xA;);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
