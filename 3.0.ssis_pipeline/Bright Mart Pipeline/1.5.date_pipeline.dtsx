      DTS:DTSID="{d3c6c303-9a55-4669-a311-68c6a2370b3e}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create_stg_date"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1A5251C7-D9D3-4D89-968D-6EB2AF2109D3}"
          SQLTask:SqlStatementSource="-- Create table if it does not exist&#xA;IF OBJECT_ID('[stg_bright_mart_sales].[dbo].[dim_date]', 'U') IS NULL&#xA;    CREATE TABLE [stg_bright_mart_sales].[dbo].[dim_date](&#xA;        [DateID] INT IDENTITY(1, 1) PRIMARY KEY,&#xA;        [transaction_date] [varchar](50) NULL,&#xA;        [customer_since] [varchar](50) NULL,&#xA;        [load_date] DATETIME DEFAULT GETDATE()&#xA;);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
