        <SQLTask:SqlTaskData
          SQLTask:Connection="{66E43A89-9026-48C9-B1BE-2B87470F4EFC}"
          SQLTask:SqlStatementSource="--create a table with proper DATE data types set to NOT NULL&#xA;IF OBJECT_ID('[stg_bright_mart_sales].[dbo].[clean_dim_product]', 'U') IS NULL&#xA;    CREATE TABLE [stg_bright_mart_sales].[dbo].[clean_dim_product](&#xA;        [ProductID]    INT IDENTITY(1, 1) PRIMARY KEY,&#xA;        [supplier]     VARCHAR(50) NOT NULL,&#xA;        [product_name] VARCHAR(50) NOT NULL,&#xA;        [category]     VARCHAR(50) NOT NULL,&#xA;        [sub_category] VARCHAR(50) NOT NULL,&#xA;        [sku]          VARCHAR(50) NOT NULL,&#xA;        [load_date]    DATETIME DEFAULT GETDATE()&#xA;    );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
