      DTS:Description="create_stg_fact"
      DTS:DTSID="{5b41c9fb-c401-4750-adb8-48ae10434867}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create_stg_fact"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1A5251C7-D9D3-4D89-968D-6EB2AF2109D3}"
          SQLTask:SqlStatementSource="-- Create table if it does not exist&#xA;IF OBJECT_ID('[stg_bright_mart_sales].[dbo].[bright_mart_fact_table]', 'U') IS NULL&#xA;&#xA;    CREATE TABLE [stg_bright_mart_sales].[dbo].[bright_mart_fact_table](&#xA;        [SalesID] INT IDENTITY(1, 1) PRIMARY KEY,&#xA;&#x9;&#x9;[unit_price] [varchar](50) NULL,&#xA;&#x9;&#x9;[cost_price] [varchar](50) NULL,&#xA;&#x9;&#x9;[qty] [varchar](50) NULL,&#xA;&#x9;&#x9;[line_amount] [varchar](50) NULL,&#xA;&#x9;&#x9;[stock_on_hand] [varchar](50) NULL,&#xA;&#x9;&#x9;[reorder_threshold] [varchar](50) NULL,&#xA;&#x9;&#x9;[transaction_amount] [varchar](50) NULL,&#xA;&#x9;&#x9;[transaction_discount] [varchar](50) NULL,&#xA;        [load_date] DATETIME DEFAULT GETDATE()&#xA;    );&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
